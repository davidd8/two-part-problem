# Server
NODE_ENV=development

# Shifts every port this clone uses, so a second clone of the repo can run its
# own dev and e2e servers at the same time. Use multiples of 10 — each clone
# gets a block: dev API 3001+n, dev web 5173+n, e2e API 3002+n, e2e web 5174+n.
PORT_OFFSET=0

# Overrides PORT_OFFSET for the API only. Normally leave this unset.
# PORT=3001

# Path to the SQLite database file, relative to the repo root.
# Use ":memory:" for an ephemeral in-memory database.
DATABASE_PATH=./data/app.sqlite
